        "scope": {
          "type": "string",
          "const": "experience_managers"
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "const": "resource_community"
        }
      },
      "required": [
        "scope"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "const": "external_public"
