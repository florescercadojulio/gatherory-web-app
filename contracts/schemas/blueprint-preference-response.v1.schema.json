{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalogKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "contentHash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "liked": {
            "type": "boolean"
          },
          "bookmarked": {
            "type": "boolean"
          },
          "notInterested": {
            "type": "boolean"
          },
          "likeRevision": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "likeContentHash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "bookmarkRevision": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "bookmarkContentHash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "notInterestedRevision": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "notInterestedContentHash": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "likeAvailability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "bookmarkAvailability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "notInterestedAvailability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "entry": {
            "type": "object",
            "properties": {
              "catalogKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "contentHash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "coverImageURL": {
                "type": "string",
                "format": "uri",
                "minLength": 1,
                "maxLength": 2048,
                "description": "1–2048 Unicode code points."
              },
              "creatorName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "catalogKey",
              "revision",
              "contentHash",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "catalogKey",
          "revision",
          "contentHash",
          "liked",
          "bookmarked",
          "notInterested",
          "bookmarkAvailability"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.gatherory.com/blueprint-preference-response/v1.json",
  "title": "Gatherory Blueprint Preferences v1"
}
