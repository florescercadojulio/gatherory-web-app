{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048,
      "description": "1–2048 Unicode code points."
    },
    "kind": {
      "type": "string",
      "const": "experience_blueprint"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
        }
      },
      "required": [
        "id",
        "revision",
        "name"
      ],
      "additionalProperties": false
    },
    "experienceDefaults": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "1–100 Unicode code points; surrounding whitespace is trimmed before validation."
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "roles": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "permissions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            }
          }
        },
        "required": [
          "key",
          "permissions"
        ],
        "additionalProperties": false
      }
    },
    "modules": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "experience_tree"
              },
              "version": {
                "type": "number",
                "const": 2
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "config": {
                "type": "object",
                "properties": {
                  "mainEventType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "children": {
                    "default": [],
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*$",
                          "not": {
                            "const": "main"
                          }
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "description": "1–120 Unicode code points; surrounding whitespace is trimmed before validation."
                        },
                        "purpose": {
                          "type": "string",
                          "enum": [
                            "planning_scouting",
                            "part_of_event"
                          ]
                        },
                        "category": {
                          "type": "string",
                          "enum": [
                            "venue",
                            "food_tasting",
                            "photography",
                            "honeymoon",
                            "attire_fitting",
                            "wedding_shower",
                            "bachelor_bachelorette",
                            "rehearsal",
                            "ceremony",
                            "reception",
                            "other"
                          ]
                        },
                        "scheduleProposal": {
                          "type": "object",
                          "properties": {
                            "anchor": {
                              "type": "string",
                              "const": "main_start"
                            },
                            "dayOffset": {
                              "type": "integer",
                              "minimum": -365,
                              "maximum": 3650
                            },
                            "localTime": {
                              "type": "string",
                              "minLength": 5,
                              "maxLength": 5,
                              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                            }
                          },
                          "required": [
                            "anchor",
                            "dayOffset",
                            "localTime"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "key",
                        "title",
                        "purpose",
                        "category"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "mainEventType",
                  "children"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "type",
              "version",
              "required",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "ideas"
              },
              "version": {
                "type": "number",
                "const": 2
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "config": {
                "type": "object",
                "properties": {
                  "categoryOrder": {
                    "default": [],
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "event",
                        "registry",
                        "link",
                        "venue",
                        "attire",
                        "flowers",
                        "food",
                        "photography",
                        "decor",
                        "invitations",
                        "honeymoon",
                        "other"
                      ]
                    }
                  },
                  "ideas": {
                    "default": [],
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "description": "1–120 Unicode code points; surrounding whitespace is trimmed before validation."
                        },
                        "category": {
                          "type": "string",
                          "enum": [
                            "event",
                            "registry",
                            "link",
                            "venue",
                            "attire",
                            "flowers",
                            "food",
                            "photography",
                            "decor",
                            "invitations",
                            "honeymoon",
                            "other"
                          ]
                        },
                        "notes": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 2000,
                          "description": "0–2000 Unicode code points; surrounding whitespace is trimmed before validation."
                        },
                        "target": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "main"
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "child"
                                },
                                "key": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 100,
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              },
                              "required": [
                                "kind",
                                "key"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "configuration": {
                          "default": {
                            "version": 1
                          },
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "number",
                              "const": 1
                            }
                          },
                          "required": [
                            "version"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "key",
                        "title",
                        "category",
                        "target",
                        "configuration"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "categoryOrder",
                  "ideas"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "type",
              "version",
              "required",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "const": "instructions"
              },
              "version": {
                "type": "number",
                "const": 1
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "config": {
                "type": "object",
                "properties": {
                  "sections": {
                    "default": [],
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "description": "1–120 Unicode code points; surrounding whitespace is trimmed before validation."
                        },
                        "body": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000,
                          "description": "1–5000 Unicode code points; surrounding whitespace is trimmed before validation."
                        },
                        "audience": {
                          "type": "string",
                          "enum": [
                            "planning_only",
                            "event_participants"
                          ]
                        },
                        "target": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "main"
                                }
                              },
                              "required": [
                                "kind"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "child"
                                },
                                "key": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 100,
                                  "pattern": "^[a-z][a-z0-9_]*$"
                                }
                              },
                              "required": [
                                "kind",
                                "key"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      },
                      "required": [
                        "key",
                        "title",
                        "body",
                        "audience",
                        "target"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "sections"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "key",
              "type",
              "version",
              "required",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "config": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "description": "1–160 Unicode code points."
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "required": [
              "key",
              "type",
              "version",
              "required",
              "config"
            ],
            "additionalProperties": false,
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "type": {
                      "const": "experience_tree"
                    },
                    "version": {
                      "const": 2
                    }
                  },
                  "required": [
                    "type",
                    "version"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "ideas"
                    },
                    "version": {
                      "const": 2
                    }
                  },
                  "required": [
                    "type",
                    "version"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "const": "instructions"
                    },
                    "version": {
                      "const": 1
                    }
                  },
                  "required": [
                    "type",
                    "version"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "coverAssetId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleOrder": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "blueprint",
    "experienceDefaults",
    "roles",
    "modules"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 5000,
          "description": "0–5000 Unicode code points."
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "1–160 Unicode code points."
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://schemas.gatherory.com/blueprint-starter/v1.json",
  "title": "Gatherory Executable Starter v1"
}
