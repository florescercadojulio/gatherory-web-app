{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "kind": {
      "type": "string",
      "const": "experience_blueprint"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "id",
        "revision",
        "name"
      ],
      "additionalProperties": false
    },
    "experienceDefaults": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "roles": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "permissions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 120,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            }
          }
        },
        "required": [
          "key",
          "permissions"
        ],
        "additionalProperties": false
      }
    },
    "modules": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "required": {
            "default": false,
            "type": "boolean"
          },
          "config": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "key",
          "type",
          "version",
          "required",
          "config"
        ],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "coverAssetId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "moduleOrder": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "blueprint",
    "experienceDefaults",
    "roles",
    "modules"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.gatherory.com/experience-blueprint/v1.json",
  "title": "Gatherory Experience Blueprint v1"
}
