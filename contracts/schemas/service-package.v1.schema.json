{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048,
      "description": "1–2048 Unicode code points."
    },
    "kind": {
      "type": "string",
      "const": "service_package"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "businessId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "countryCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "1–100 Unicode code points; surrounding whitespace is trimmed before validation."
        }
      },
      "required": [
        "countryCode",
        "timeZone"
      ],
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "minimumGuests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "includedGuests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumGuests": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "starting": {
          "type": "object",
          "properties": {
            "amountMinor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
              "description": "Nonnegative integer minor units as a canonical digit string. Never a decimal amount or JSON number. Interpret using the currency exponent.",
              "examples": [
                "0",
                "1",
                "100",
                "10000"
              ]
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$",
              "description": "Uppercase ISO 4217 currency code. Shape validation only; operations must validate supported currencies."
            }
          },
          "required": [
            "amountMinor",
            "currency"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "string",
          "enum": [
            "fixed",
            "starting_at",
            "base_plus_guest",
            "custom_quote"
          ]
        },
        "additionalGuest": {
          "type": "object",
          "properties": {
            "amountMinor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
              "description": "Nonnegative integer minor units as a canonical digit string. Never a decimal amount or JSON number. Interpret using the currency exponent.",
              "examples": [
                "0",
                "1",
                "100",
                "10000"
              ]
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$",
              "description": "Uppercase ISO 4217 currency code. Shape validation only; operations must validate supported currencies."
            }
          },
          "required": [
            "amountMinor",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "starting",
        "model"
      ],
      "additionalProperties": false
    },
    "includedServices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "1–60 Unicode code points; surrounding whitespace is trimmed before validation."
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "serviceId",
          "quantity",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "addOns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "1–160 Unicode code points; surrounding whitespace is trimmed before validation."
          },
          "starting": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])",
                "description": "Nonnegative integer minor units as a canonical digit string. Never a decimal amount or JSON number. Interpret using the currency exponent.",
                "examples": [
                  "0",
                  "1",
                  "100",
                  "10000"
                ]
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3,
                "pattern": "^[A-Z]{3}$",
                "description": "Uppercase ISO 4217 currency code. Shape validation only; operations must validate supported currencies."
              }
            },
            "required": [
              "amountMinor",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "serviceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "businessId",
    "name",
    "blueprint",
    "pricing",
    "includedServices",
    "addOns"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.gatherory.com/service-package/v1.json",
  "title": "Gatherory Service Package v1"
}
