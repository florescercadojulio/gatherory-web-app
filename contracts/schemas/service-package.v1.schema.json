{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "kind": {
      "type": "string",
      "const": "service_package"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "businessId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "properties": {
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "countryCode",
        "timeZone"
      ],
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "minimumGuests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "includedGuests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximumGuests": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "properties": {
        "starting": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "string",
          "enum": [
            "fixed",
            "starting_at",
            "base_plus_guest",
            "custom_quote"
          ]
        },
        "additionalGuest": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "amount",
            "currency"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "starting",
        "model"
      ],
      "additionalProperties": false
    },
    "includedServices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "serviceId",
          "quantity",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "addOns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "starting": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "serviceId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "businessId",
    "name",
    "blueprint",
    "pricing",
    "includedServices",
    "addOns"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.gatherory.com/service-package/v1.json",
  "title": "Gatherory Service Package v1"
}
