# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherory
DATABASE_POOL_MAX=5

# Better Auth
# Generate with: pnpm auth:secret or pnpm dlx auth@1.7.7 secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3003

# Social sign-in (leave a pair blank to disable that provider server-side)
# Google redirect URI: http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple redirect URI: http://localhost:3003/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional application metadata
VITE_APP_TITLE=Gatherory

# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
