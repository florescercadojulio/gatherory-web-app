# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherory
DATABASE_POOL_MAX=5

# Better Auth
# Generate with: pnpm auth:secret or pnpm dlx auth@1.7.7 secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3003

# Social sign-in (leave a pair blank to disable that provider server-side)
# Google redirect URI: http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple requires HTTPS and does not accept localhost return URLs.
# Production redirect URI: https://app.gatherory.com/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Preserve the PEM header/footer. Quoted values may use literal \\n sequences.
APPLE_PRIVATE_KEY=
# Required for native Apple code exchange and deletion-time revocation; must
# match the iOS app's bundle identifier in the Apple identity token.
APPLE_APP_BUNDLE_IDENTIFIER=com.guide-systems.gatherory

# Transactional email
# Create an API key at https://resend.com/api-keys and verify the sender domain.
RESEND_API_KEY=
EMAIL_FROM="Gatherory <hello@your-verified-domain.com>"
EMAIL_REPLY_TO=

# Firebase Cloud Messaging (server only; leave credentials blank to disable)
# From the Firebase service-account JSON: project_id, client_email, private_key.
# The Apple APNs .p8 is uploaded to Firebase Cloud Messaging settings instead.
# Keep these separate from APPLE_* above, which are for Sign in with Apple.
FCM_PROJECT_ID=gatherory-e4d8b
FCM_CLIENT_EMAIL=
# Quote the PEM value; literal \n escapes from the JSON private_key are supported.
FCM_PRIVATE_KEY=

# Immediate best-effort sends use the configured FCM credentials after a saved change.
# Scheduled retry/recovery infrastructure is retained for later and stays disabled.
# No cron schedule is installed. Leave this false and do not run notifications:worker.
# An external scheduler sends CRON_SECRET as a Bearer token; use at least 32 random characters.
NOTIFICATION_DISPATCH_ENABLED=false
CRON_SECRET=

# Cloudflare R2 media storage
# Keep event, idea, registry, and invitation media private by default.
# Development uses gatherory-private-dev. Set gatherory-private-prod only in the
# production environment; never expose either bucket through a public domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=gatherory-private-dev
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=gatherory-public
VITE_PUBLIC_ASSET_URL=https://cdn.gatherory.com

# Optional application metadata
VITE_APP_TITLE=Gatherory

# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
