# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatherory
DATABASE_POOL_MAX=5

# Better Auth
# Generate with: pnpm auth:secret or pnpm dlx auth@1.7.7 secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3003

# Social sign-in (leave a pair blank to disable that provider server-side)
# Google redirect URI: http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple requires HTTPS and does not accept localhost return URLs.
# Production redirect URI: https://app.gatherory.com/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Preserve the PEM header/footer. Quoted values may use literal \\n sequences.
APPLE_PRIVATE_KEY=
# Native Sign in with Apple accepts the iOS app's bundle identifier as the token audience.
APPLE_APP_BUNDLE_IDENTIFIER=com.guide-systems.gatherory

# Transactional email
# Create an API key at https://resend.com/api-keys and verify the sender domain.
RESEND_API_KEY=
EMAIL_FROM="Gatherory <hello@your-verified-domain.com>"
EMAIL_REPLY_TO=

# Cloudflare R2 media storage
# Keep event, idea, registry, and invitation media private by default.
# Development uses gatherory-private-dev. Set gatherory-private-prod only in the
# production environment; never expose either bucket through a public domain.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=gatherory-private-dev
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=gatherory-public
VITE_PUBLIC_ASSET_URL=https://cdn.gatherory.com

# Optional application metadata
VITE_APP_TITLE=Gatherory

# Optional analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
