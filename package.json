{
  "name": "gatherory-web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv run -f .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3003\"",
    "dev:device": "dotenv run -f .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --host 0.0.0.0 --port 3003\"",
    "generate-routes": "tsr generate",
    "test": "pnpm contracts:check && tsx --test tests/*.test.ts",
    "test:invitations:local": "dotenv run -f .env.local -- sh -c 'RUN_INVITATION_DB_TESTS=1 RUN_INVITATION_HTTP_TESTS=1 tsx --test tests/event-invitations.database.test.ts tests/event-invitations.test.ts tests/guest-invitation-content.test.ts tests/invitation-http.database.test.ts'",
    "typecheck": "tsc --noEmit",
    "moderation:grant": "dotenv run -f .env.local -- tsx scripts/grant-moderator.ts",
    "test:media:r2": "dotenv run -f .env.local -- sh -c 'RUN_R2_MEDIA_TESTS=1 tsx --test tests/native-media-r2.test.ts'",
    "test:account-deletion:local": "dotenv run -f .env.local -- sh -c 'RUN_ACCOUNT_DELETION_HTTP_TESTS=1 RUN_ACCOUNT_DELETION_R2_TESTS=1 tsx --test tests/account-deletion-http.database.test.ts'",
    "test:apple-tokens:local": "dotenv run -f .env.local -- sh -c 'RUN_APPLE_TOKEN_DB_TESTS=1 tsx --test tests/apple-token-revocation.database.test.ts'",
    "contracts:generate": "tsx scripts/generate-contract-schemas.ts",
    "contracts:check": "tsx scripts/generate-contract-schemas.ts --check",
    "auth:schema": "dotenv run -f .env.local -- pnpm dlx auth@1.7.7 generate --config ./src/lib/auth.ts --output ./src/db/schema/auth.schema.ts --yes",
    "auth:check": "dotenv run -f .env.local -- pnpm dlx auth@1.7.7 check schema --config ./src/lib/auth.ts",
    "auth:secret": "pnpm dlx auth@1.7.7 secret",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:materialize-native": "tsx scripts/materialize-native-sync.ts",
    "db:materialize-native:local": "dotenv run -f .env.local -- pnpm db:materialize-native",
    "db:push": "drizzle-kit push",
    "db:reset": "dotenv run -f .env.local -- tsx scripts/reset-database.ts",
    "db:reset:neon": "tsx scripts/reset-neon-database.ts",
    "db:seed": "dotenv run -f .env.local -- tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "email:dev": "email dev --dir src/emails --port 3004",
    "media:check": "tsx scripts/check-media-storage.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --import ./instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth-ui/core": "^1.7.27",
    "@better-auth-ui/react": "^1.7.27",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/i18n": "^1.7.7",
    "@effect/sql-pg": "4.0.0-beta.102",
    "@faker-js/faker": "^10.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@posthog/react": "^1.7.0",
    "@react-email/ui": "^6.11.1",
